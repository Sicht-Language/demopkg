start
create library terminal

create function terminal_prompt(text)
    effect input
    print text
    set answer to input
    give answer
endfunction

create function terminal_menu(options)
    effect input
    set i to 0
    for each o in(options)
        print cast i to string + ": " + o
        set i to i + 1
    endfor
    set choice to input "pick> "
    give choice
endfunction

offer terminal_prompt
offer terminal_menu
end
